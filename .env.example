HUB_HOST=127.0.0.1
HUB_PORT=8787
HUB_URL=wss://127.0.0.1:8787
AGENT_IDS=agent-a,agent-b,agent-c
STATE_ROOT=.state/local

# Hub Postgres. Default points at infra/local/docker-compose.yml (port 5433).
# A local Postgres can be used instead, e.g. postgres://meetmesh:meetmesh@127.0.0.1:5432/meetmesh
DATABASE_URL=postgres://meetmesh:meetmesh@127.0.0.1:5433/meetmesh

# wss:// development certificates generated by `npm run certs` into .state/certs.
CERT_DIR=.state/certs

# Use a separate, disposable PostgreSQL database for the regression gate.
# DATABASE_URL=postgres://meetmesh:meetmesh@127.0.0.1:5433/meetmesh_test
# M3_TEST_DATABASE_URL=postgres://meetmesh:meetmesh@127.0.0.1:5433/meetmesh_test

# Run the device demo on a dedicated database. Set the email addresses locally
# only for a live Calendar run with two consenting test accounts.
# M5_DEVICE_DATABASE_URL=postgres://meetmesh:meetmesh@127.0.0.1:5433/meetmesh_devices
# M5_GOOGLE_A=
# M5_GOOGLE_B=

# One iPhone and two simulated Mac participants (npm run demo:m5:phone).
# M5_PHONE_DATABASE_URL=postgresql://127.0.0.1:5432/meetmesh_phone_lab

# OpenRouter is used for meeting previews. Set the key in the ignored .env
# file or store it in ~/.config/meetmesh/openrouter-api-key (permissions 600).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
