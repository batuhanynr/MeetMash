HUB_HOST=127.0.0.1
HUB_PORT=8787
HUB_URL=wss://127.0.0.1:8787
AGENT_IDS=agent-a,agent-b,agent-c
STATE_ROOT=.state/local

# Hub Postgres. Default points at infra/local/docker-compose.yml (port 5433).
# A local Postgres can be used instead, e.g. postgres://meetmesh:meetmesh@127.0.0.1:5432/meetmesh
DATABASE_URL=postgres://meetmesh:meetmesh@127.0.0.1:5433/meetmesh

# wss:// development certificates generated by `npm run certs` into .state/certs.
CERT_DIR=.state/certs
