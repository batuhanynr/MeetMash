{
  "name": "meetmesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MeetMesh mobile and reference agent monorepo",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/hub",
    "apps/agent-node",
    "packages/protocol",
    "packages/runtime"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "doctor": "node scripts/doctor.ts",
    "check:mobile": "cd apps/mobile && flutter analyze && flutter test",
    "hub": "node --env-file-if-exists=.env apps/hub/src/main.ts",
    "test:protocol": "node --test tests/protocol/*.test.ts",
    "agent": "node --env-file-if-exists=.env apps/agent-node/src/main.ts",
    "local": "node --env-file-if-exists=.env scripts/local.ts",
    "local:reset": "node --env-file-if-exists=.env scripts/reset-local.ts",
    "demo:m1": "node scripts/m1.ts",
    "test": "node --test --test-reporter=spec tests/protocol/*.test.ts tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:gate:m1": "node scripts/gate-m1.ts",
    "test:regression": "npm run test:gate:m1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
